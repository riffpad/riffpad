# Relay（云端中继）
RELAY_PORT=8080
RELAY_PUBLIC_URL=ws://localhost:8080
RELAY_DB_URL=postgresql://localhost:5432/riffpad-relay

# Daemon（用户电脑）
DAEMON_RELAY_URL=ws://localhost:8080
# 设备配对：daemon 启动时生成配对码，手机扫码绑定后写入
DAEMON_PAIRING_TOKEN=

# Mobile
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080

# Relay（可选；留空 = 仅本机模式）
RIFFPAD_RELAY_URL=ws://127.0.0.1:9090
RIFFPAD_HOST_ID=
# relay 用户（首次启动自动登录并注册 host；之后 token/hostSecret 存 config.json）
RIFFPAD_RELAY_USER=
RIFFPAD_RELAY_PASSWORD=
